# --- Supabase ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key (safe for the browser, RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key -- SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- EmailJS (client-side, only triggered from an authenticated admin session) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- App ---
# Absolute base URL, used for building magic-link redirect URLs.
# Local: http://localhost:3000  |  Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
